{
  "manifest_version": 3,
  "name": "LeetCode Local Importer",
  "version": "1.0",
  "description": "Imports LeetCode problem statements into the local SQLite database.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode-solution-editor.vercel.app/*"
  ]
}
